generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  tenantId          String               @id @default(uuid()) @map("tenant_id")
  tenantCode        String?              @unique @map("tenant_code") @db.VarChar(20) // <-- Kode publik: OB-MTR-4821
  businessName      String               @map("business_name") @db.VarChar(100)
  businessType      String?              @map("business_type") @db.VarChar(50)
  address           String?
  waNumber          String               @default("PENDING") @map("wa_number") @db.VarChar(20)
  recoveryEmail     String?              @unique @map("recovery_email") @db.VarChar(120)
  status            String               @default("FREE_TRIAL") @map("status") @db.VarChar(20)
  maxSales          Int                  @default(2) @map("max_sales")
  tenantType        String               @default("PERSONAL") @map("tenant_type") @db.VarChar(20)
  keyBotTenant      String               @unique @default(uuid()) @map("key_bot_tenant")
  createdAt         DateTime             @default(now()) @map("created_at")
  subscriptionStart DateTime             @default(now()) @map("subscription_start")
  subscriptionEnd   DateTime             @map("subscription_end")
  botNodes          BotNode[]
  botSessions       BotSession[]
  leads             Lead[]
  products          Product[]
  quotations        Quotation[]
  schedules         Schedule[]
  users             User[]
  whatsappAuths     WhatsappAuth[]
  aiBotConfig       AiBotConfig?
  transactions      PaymentTransaction[] // <-- Tambahkan baris relasi balik ini

  @@map("tenants")
}


model WhatsappAuth {
  authId   String @id @default(uuid()) @map("auth_id")
  tenantId String @map("tenant_id")
  key      String @db.VarChar(255)
  value    String
  tenant   Tenant @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("whatsapp_auths")
}

model User {
  userId      String      @id @default(uuid()) @map("user_id")
  tenantId    String      @map("tenant_id")
  name        String      @db.VarChar(100)
  phoneNumber String      @unique @map("phone_number") @db.VarChar(20)
  role        String      @default("SALES") @db.VarChar(20)
  isActive    Boolean     @default(true) @map("is_active") // ✅ Tambahkan baris ini
  createdAt   DateTime    @default(now()) @map("created_at")
  loginToken  String?     @map("login_token") @db.VarChar(6)
  tokenExpiry DateTime?   @map("token_expiry")
  leads       Lead[]
  quotations  Quotation[]
  schedules   Schedule[]
  tenant      Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}


model BotSession {
  customerPhoneNumber String   @map("customer_phone_number")
  tenantId            String   @map("tenant_id")
  currentNodeId       String   @map("current_node_id")
  updatedAt           DateTime @updatedAt @map("updated_at")
  tenant              Tenant   @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@id([tenantId, customerPhoneNumber])
  @@map("bot_sessions")
}

model Lead {
  leadId            String      @id @default(uuid()) @map("lead_id")
  tenantId          String      @map("tenant_id")
  phoneNumber       String      @map("phone_number") @db.VarChar(20)
  formData          Json        @default("{}") @map("form_data")
  status            String      @default("BOT_PROCESS") @db.VarChar(30)
  sourceLeads       String      @default("WHATSAPP_BOT") @db.VarChar(50)
  assignedToSalesId String?     @map("assigned_to_sales_id")
  assignedSalesName String?     @map("assigned_sales_name") @db.VarChar(100)
  createdAt         DateTime    @default(now()) @map("created_at")
  sales             User?       @relation(fields: [assignedToSalesId], references: [userId])
  tenant            Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  quotations        Quotation[]
  schedules         Schedule[]

  @@index([tenantId, phoneNumber])
  @@index([phoneNumber])
  @@map("leads")
}

model AiBotConfig {
  configId       String         @id @default(uuid()) @map("config_id")
  tenantId       String         @unique @map("tenant_id")
  openingMessage String         @map("opening_message") @db.Text
  closingMessage String         @map("closing_message") @db.Text
  salesGroupJid  String?        @map("sales_group_jid") @db.VarChar(100) // <-- Tambahkan ini
  keywordTrigger String         @default("GLOBAL_FLOW") @map("keyword_trigger") @db.VarChar(50)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  subjects       AiBotSubject[]

  @@map("ai_bot_configs")
}


model AiBotSubject {
  subjectId     String       @id @default(uuid()) @map("subject_id")
  configId      String       @map("config_id")
  name          String       @db.VarChar(100) // Contoh: Layanan Pembelian Retail
  targetData    String       @map("target_data") @db.Text // Contoh: Nama, Alamat, Ukuran Baju
  toneStyle     String       @map("tone_style") @db.VarChar(150) // Contoh: Ramah, pakai emoji
  routingType   String       @default("ROUND_ROBIN") @map("routing_type") @db.VarChar(30) // "ROUND_ROBIN" atau "DIRECT"
  targetSalesId String?      @map("target_sales_id") // Menyimpan user_id dari model User jika tipe DIRECT
  aiPrompt      String       @map("ai_prompt") @db.Text // Prompt otomatis hasil racikan background
  
  botConfig     AiBotConfig  @relation(fields: [configId], references: [configId], onDelete: Cascade)

  @@map("ai_bot_subjects")
}

model Schedule {
  scheduleId    String    @id @default(uuid()) @map("schedule_id")
  tenantId      String    @map("tenant_id")
  leadId        String    @map("lead_id")
  salesId       String?   @map("sales_id")
  eventType     EventType @map("event_type")
  title         String    @db.VarChar(100)
  description   String?
  isUpdated     Int       @default(0) @map("is_updated") @db.SmallInt
  outcomeStatus String?   @map("outcome_status") @db.VarChar(20)
  lastStatus    String?   @map("last_status") @db.VarChar(20)
  outcomeData   Json      @default("{}") @map("outcome_data")
  scheduledAt   DateTime  @map("scheduled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  lead          Lead      @relation(fields: [leadId], references: [leadId], onDelete: Cascade)
  sales         User?     @relation(fields: [salesId], references: [userId], onDelete: Cascade)
  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([salesId])
  @@map("schedules")
}

model LeadQueue {
  tenantId    String   @map("tenant_id")
  subjectName String   @map("subject_name")
  lastSalesId String   @map("last_sales_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([tenantId, subjectName])
  @@map("lead_queues")
}


model Product {
  productId      String          @id @default(uuid()) @map("product_id")
  tenantId       String          @map("tenant_id")
  productName    String          @map("product_name") @db.VarChar(150)
  description    String?         @map("des_produk")
  costPrice      Decimal         @map("harga_hpp") @db.Decimal(12, 2)
  maxDiscount    Decimal         @default(0.00) @map("max_diskon") @db.Decimal(5, 2)
  status         ProductStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  quotationItems QuotationItem[]

  @@index([tenantId])
  @@map("products")
}


model BotNode {
  nodeId            String      @id @default(uuid()) @map("node_id")
  tenantId          String      @map("tenant_id")
  nodeType          String      @default("STANDARD") @map("node_type") @db.VarChar(20)
  messageText       String      @map("message_text")
  isFormInput       Boolean     @default(false) @map("is_form_input")
  saveToField       String?     @map("save_to_field")
  nextDefaultNodeId String?     @map("next_default_node_id")
  tenant            Tenant      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  options           BotOption[]

  @@index([tenantId])
  @@map("bot_nodes")
}

model BotOption {
  optionId   String  @id @default(uuid()) @map("option_id")
  nodeId     String  @map("node_id")
  triggerKey String  @map("trigger_key")
  label      String
  nextNodeId String  @map("next_node_id")
  node       BotNode @relation(fields: [nodeId], references: [nodeId], onDelete: Cascade)

  @@unique([nodeId, triggerKey])
  @@map("bot_options")
}

// Tabel untuk pilihan durasi & diskon paket (1 Bulan, 3 Bulan, 1 Tahun, dll.)
model SubscriptionPlan {
  planId    String   @id @default(uuid()) @map("plan_id")
  name      String   @db.VarChar(50)        // Contoh: "1 Bulan", "3 Bulan", "1 Tahun"
  months    Int                             // Contoh: 1, 3, 12
  discount  Float    @default(0)            // Contoh: 0, 0.1 (10%), 0.2 (20%)
  badge     String?  @db.VarChar(30)        // Contoh: "HEMAT 10%", "PALING LARIS"
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(1) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscription_plans")
}

// Tabel 1 baris untuk konfigurasi harga satuan sales & rekening tujuan transfer
model BillingSetting {
  settingId     String   @id @default("DEFAULT_BILLING") @map("setting_id")
  pricePerSales Int      @default(49000) @map("price_per_sales")
  bankName      String   @default("BCA a.n. OmniBot Engine") @map("bank_name") @db.VarChar(100)
  bankAccount   String   @default("1234567890") @map("bank_account") @db.VarChar(50)
  qrisImageUrl  String?  @map("qris_image_url") @db.Text
  adminWaNumber String   @default("6285177868126") @map("admin_wa_number") @db.VarChar(20)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("billing_settings")
}


model PaymentTransaction {
  transactionId String    @id @default(uuid()) @map("transaction_id")
  orderId       String    @unique @map("order_id") @db.VarChar(100) // Contoh: "INV-20261121-XXXX"
  tenantId      String    @map("tenant_id")
  salesQuota    Int       @map("sales_quota")                      // Jumlah akun sales yang dibeli
  months        Int                                                // Durasi bulan (1, 3, 12)
  amount        Int                                                // Total rupiah yang harus dibayar
  paymentMethod String    @default("MANUAL") @map("payment_method") @db.VarChar(30) // "MANUAL" atau "MIDTRANS"
  snapToken     String?   @map("snap_token") @db.Text              // Untuk token popup Midtrans nanti
  status        String    @default("PENDING") @db.VarChar(20)      // "PENDING", "PAID", "EXPIRED", "FAILED"
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("payment_transactions")
}




model Quotation {
  quotationId String          @id @default(uuid()) @map("quotation_id")
  tenantId    String          @map("tenant_id")
  leadId      String          @map("lead_id")
  salesId     String?         @map("sales_id")
  quotationNo String          @map("quotation_no") @db.VarChar(50)
  totalAmount Decimal         @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status      QuotationStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       QuotationItem[]
  lead        Lead            @relation(fields: [leadId], references: [leadId], onDelete: Cascade)
  sales       User?           @relation(fields: [salesId], references: [userId])
  tenant      Tenant          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, quotationNo])
  @@index([tenantId])
  @@index([leadId])
  @@map("quotations")
}

model QuotationItem {
  quotationItemId String    @id @default(uuid()) @map("quotation_item_id")
  quotationId     String    @map("quotation_id")
  productId       String    @map("product_id")
  quantity        Int       @default(1)
  sellingPrice    Decimal   @map("selling_price") @db.Decimal(12, 2)
  discountGiven   Decimal   @default(0.00) @map("discount_given") @db.Decimal(12, 2)
  product         Product   @relation(fields: [productId], references: [productId])
  quotation       Quotation @relation(fields: [quotationId], references: [quotationId], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

enum EventType {
  CALL
  MEETING
  DEMO
  SURVEY
  NEGO
  LOSS
  GOAL
  WAITING_ASSIGN
  WAITING_SCHEDULE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}
